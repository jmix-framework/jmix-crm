<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://homeView.title" focusMode="NO_FOCUS">
    <facets>
        <settings id="settingsFacet" auto="true"/>
    </facets>
    <layout padding="false" classNames="dashboard-grid-container">
        <fragment id="webinarBannerFragment" class="com.company.crm.view.webinar.WebinarBannerFragment">
            <properties>
                <property name="url"
                          value="https://event.jmix.ru/ai_dev_control_webinar?utm_source=demo-b2b-crm&amp;utm_medium=referral&amp;utm_campaign=ai_dev_control_webinar"/>
                <property name="domain" value="JMIX_RU"/>
            </properties>
        </fragment>
        <gridLayout width="100%" classNames="dashboard-grid">
            <vbox id="leftBox" classNames="dashboard-grid-main-content">
                <formLayout id="leftContent" width="100%"/>
            </vbox>

            <vbox id="rightBox" classNames="dashboard-grid-secondary-content">
                <formLayout id="rightContent"/>
            </vbox>
        </gridLayout>
    </layout>
</view>
