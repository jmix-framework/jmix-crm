<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://homeView.title" focusMode="NO_FOCUS">
    <facets>
        <settings id="settingsFacet" auto="true"/>
    </facets>
    <layout padding="false" classNames="dashboard-grid-container">
        <vbox id="webinarBannerBox" classNames="webinar-banner-container" visible="false" width="100%"
              justifyContent="CENTER" justifySelf="CENTER" alignSelf="CENTER" alignItems="CENTER">
            <hbox id="webinarBanner" classNames="webinar-banner" width="100%"
                  justifyContent="CENTER" justifySelf="CENTER" alignSelf="CENTER" alignItems="CENTER">
                <button id="webinarBannerCloseButton" classNames="webinar-banner-close"/>
            </hbox>
        </vbox>

        <gridLayout width="100%" classNames="dashboard-grid">
            <vbox id="leftBox" classNames="dashboard-grid-main-content">
                <formLayout id="leftContent" width="100%"/>
            </vbox>

            <vbox id="rightBox" classNames="dashboard-grid-secondary-content">
                <formLayout id="rightContent"/>
            </vbox>
        </gridLayout>
    </layout>
</view>
