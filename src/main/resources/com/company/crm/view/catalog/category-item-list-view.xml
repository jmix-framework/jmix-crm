<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://categoryItemListView.title" focusMode="NO_FOCUS">
    <data>
        <collection id="categoryItemsDc"
                    class="com.company.crm.model.catalog.item.CategoryItem">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="categoryItemsDl" readOnly="true"/>
        </collection>
        <instance id="productPreviewDc" class="com.company.crm.model.catalog.item.CategoryItem"/>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="false"/>
        <urlQueryParameters>
            <pagination component="items_pagination"/>
            <genericFilter component="items_advancedFilter"/>
            <dataGridFilter component="categoryItemsDataGrid"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout classNames="product-list-view">
        <div width="100%" maxWidth="40em">
            <formLayout width="100%">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                    <responsiveStep minWidth="20em" columns="2"/>
                </responsiveSteps>
                <textField id="items_searchField" placeholder="msg://searchField.placeholder" clearButtonVisible="true">
                    <prefix>
                        <icon icon="SEARCH"/>
                    </prefix>
                </textField>
                <select id="items_categorySelect" placeholder="Category" emptySelectionAllowed="true"
                        emptySelectionCaption="msg://allCategories"/>
            </formLayout>
            <genericFilter id="items_advancedFilter" dataLoader="categoryItemsDl"
                           opened="false" summaryText="msg:///advanced" themeNames="filled">
                <properties include="(name)|(code)|(category)|(uom)|(price)"/>
            </genericFilter>
        </div>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="categoryItemsDataGrid.createAction"/>
                <button id="editButton" action="categoryItemsDataGrid.editAction"/>
                <button id="removeButton" action="categoryItemsDataGrid.removeAction"/>
                <button id="downloadXlsButton" action="categoryItemsDataGrid.downloadXls"/>
                <fileUploadField id="updateCatalogField" uploadIcon="UPLOAD_ALT" uploadText="msg://updateFromXlsx"
                                 acceptedFileTypes=".xlsx"/>
            </startSlot>
            <endSlot>
                <simplePagination id="items_pagination" dataLoader="categoryItemsDl" itemsPerPageVisible="true"/>
                <gridColumnVisibility dataGrid="categoryItemsDataGrid" icon="COG_O"
                                      themeNames="tertiary-inline" hideAllEnabled="false"/>
            </endSlot>
        </hbox>
        <sidePanelLayout id="productPreview" width="100%" height="100%" minHeight="0px"
                         sidePanelPosition="RIGHT" sidePanelOverlay="true" modal="false"
                         sidePanelHorizontalSize="24rem" sidePanelHorizontalMaxSize="100%"
                         closeOnOutsideClick="false">
            <dataGrid id="categoryItemsDataGrid"
                      dataContainer="categoryItemsDc"
                      width="100%"
                      height="100%"
                      minHeight="20em"
                      multiSort="true"
                      selectionMode="MULTI"
                      columnReorderingAllowed="true">
                <actions>
                    <action id="createAction" type="list_create">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="editAction" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="removeAction" type="list_remove"/>
                    <action id="downloadXls" text="msg://downloadXlsx" icon="DOWNLOAD_ALT"/>
                </actions>
                <columns resizable="true" sortable="true">
                    <column property="image" width="6.5rem" flexGrow="0" sortable="false" resizable="false"/>
                    <column property="name"/>
                    <column property="code"/>
                    <column property="category"/>
                    <column property="uom"/>
                    <column property="price" filterable="true"/>
                </columns>
            </dataGrid>
            <vbox width="100%" height="100%" padding="false" spacing="false"
                  classNames="product-preview">
                <hbox width="100%" alignItems="CENTER" justifyContent="BETWEEN"
                      classNames="product-preview-header">
                    <h3 id="previewName" dataContainer="productPreviewDc" property="name"/>
                    <sidePanelLayoutCloser id="productPreviewCloser" ariaLabel="msg:///actions.Close"/>
                </hbox>
                <scroller width="100%" height="100%" scrollBarsDirection="VERTICAL">
                    <vbox width="100%" classNames="product-preview-content">
                        <image id="previewImage" resource="images/no_image.svg" classNames="product-preview-image"/>
                        <span id="previewCategory" dataContainer="productPreviewDc" property="category"
                              classNames="product-preview-category"/>
                        <hbox width="100%" alignItems="BASELINE" justifyContent="BETWEEN">
                            <span id="previewCode" dataContainer="productPreviewDc" property="code"
                                  classNames="product-preview-code"/>
                            <hbox alignItems="BASELINE" spacing="false" classNames="product-preview-pricing">
                                <span id="previewPrice" classNames="product-preview-price"/>
                                <span id="previewUom" dataContainer="productPreviewDc" property="uom"
                                      classNames="product-preview-uom"/>
                            </hbox>
                        </hbox>
                        <span id="previewDescription" dataContainer="productPreviewDc" property="description"
                              classNames="product-preview-description"/>
                    </vbox>
                </scroller>
            </vbox>
        </sidePanelLayout>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
