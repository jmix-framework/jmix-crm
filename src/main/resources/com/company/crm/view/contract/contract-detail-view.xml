<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://contractDetailView.title"
      focusComponent="form">
    <data>
        <instance id="contractDc"
                  class="com.company.crm.model.contract.Contract">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="contractDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="contractDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="numberField" property="number"/>
            <entityComboBox id="clientField" property="client">
                <itemsQuery class="com.company.crm.model.client.Client"
                            searchStringFormat="(?i)%${inputString}%"
                            escapeValueForLike="true">
                    <fetchPlan extends="_instance_name"/>
                    <query>
                        <![CDATA[select e from Client e where e.name like :searchString escape '\' order by e.name]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
            <datePicker id="signedDateField" property="signedDate"/>
            <datePicker id="validUntilField" property="validUntil"/>
            <bigDecimalField id="amountField" property="amount"/>
            <textArea id="commentField" property="comment" height="8em" colspan="2"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
