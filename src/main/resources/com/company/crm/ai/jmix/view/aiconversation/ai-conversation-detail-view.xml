<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://aiConversationDetailView.title">
    <data>
        <instance id="aiConversationDc"
                  class="com.company.crm.ai.entity.AiConversation">
            <fetchPlan extends="_base">
                <property name="messages" fetchPlan="_base"/>
                <property name="attachments" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="aiConversationDl"/>
        </instance>
        <collection id="attachmentsDc"
                    class="com.company.crm.ai.entity.AiConversationAttachment">
            <fetchPlan extends="_base"/>
            <loader id="attachmentsDl">
                <query>
                    <![CDATA[select e from AiConversationAttachment e where e.conversation = :conversation order by e.createdDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <split id="conversationSplit" orientation="HORIZONTAL" width="100%" height="100%" splitterPosition="74">
            <vbox id="chatPanel" width="100%" height="100%" spacing="true" padding="true"/>
            <vbox id="attachmentsPanel" width="20rem" height="100%" spacing="false" padding="true">
                <span id="attachmentsTitle"
                      text="msg://com.company.crm.ai.jmix.view.aiconversation/attachmentsPanelTitle"
                      classNames="text-secondary"/>
                <gridLayout id="attachmentsGridLayout"
                            itemsContainer="attachmentsDc"
                            width="100%"
                            gap="var(--lumo-space-xs)">
                    <fragmentRenderer class="com.company.crm.ai.jmix.view.aiconversation.AiAttachmentCardFragmentRenderer"/>
                </gridLayout>
                <span id="attachmentsEmptyState"
                      text="msg://com.company.crm.ai.jmix.view.aiconversation/attachmentsEmptyState"
                      classNames="text-secondary text-s"
                      visible="false"/>
                <upload id="attachmentUpload"
                        width="100%"
                        classNames="attachments-dropzone"
                        acceptedFileTypes=".pdf,.csv,.doc,.docx,.xls,.xlsx,.html,.htm,.txt,.md,.png,.jpg,.jpeg,.gif,.webp"
                        uploadText="msg://com.company.crm.ai.jmix.view.aiconversation/attachmentUploadField.uploadText"
                        dropLabel="msg://com.company.crm.ai.jmix.view.aiconversation/attachmentUpload.dropLabel"
                        dropAllowed="true"
                        receiverType="FILE_TEMPORARY_STORAGE_BUFFER"
                        maxFiles="1"/>
            </vbox>
        </split>
    </layout>
</view>
